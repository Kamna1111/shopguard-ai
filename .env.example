# Copy this file to .env for local development. Never put real secrets here.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000

# Local macOS PostgreSQL socket. Docker Compose uses its own database container.
DATABASE_URL=postgresql+psycopg:///shopguard
# Optional local Docker database password. Change it for a shared environment.
POSTGRES_PASSWORD=shopguard-local-only
REDIS_URL=redis://localhost:6379/0
# Demonstration rate only; this is not a real jurisdiction's tax rule.
SHOP_TAX_RATE=0.08

# Local token signing key. Replace in your private .env before deploying.
JWT_SECRET_KEY=local-only-change-me

# Optional: set both values, then run make db-seed to create a local admin.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Add a real provider key only to your private .env file, never to Git.
OPENAI_API_KEY=
AI_PROVIDER=mock
OPENAI_MODEL=gpt-6.2-astra
